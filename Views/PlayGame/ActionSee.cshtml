@using NovelProject.AlterModels
@model CheckActModel

@{
    ViewData["Title"] = $"Action {Model.Act.Name}";
    Layout = null; 
    string actionUrl = Model.StartActOrEnd
        ? Url.Action("ActionSeePart", "PlayGame", new { partId = Model.PartId, actId = Model.Act.Id, StartAct = true, sceneId = Model.SceneId })
        : Url.Action("ChangePart", "PlayGame", new { partId = Model.PartId, actId = Model.Act.Id, sceneId = Model.SceneId});
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/game.css" />
</head>
<body>
    <button id="game-menu-button" class="game-menu-button">
    <img id="menu-icon" src="/wwwroot/img/Purpule_Icon/НАЛАШТУВАННЯ.png" alt="Menu" />
    </button>
    <div id="gameMenuOverlay" class="game-menu-overlay hidden"></div>
    <div id="gameMenu" class="game-menu hidden">
        <button class="game-menu-item" onclick="alert('Settings not implemented yet')">Налаштування</button>
        <form method="get" asp-controller="PlayGame" asp-action="ManualSaveGame">
            <input type="hidden" name="partId" value="@Model.PartId" />
            <input type="hidden" name="actId" value="@Model.Act.Id" />
            <input type="hidden" name="sceneId" value="@Model.SceneId" />
            <input type="hidden" name="StartAct" value="@(Model.StartActOrEnd.ToString().ToLower())" />
            <input type="hidden" name="IsSaveFromAct" value="true" />
            <button class="game-menu-item" type="submit">Головне меню</button>
        </form>
        <button id="close-menu-btn" class="game-menu-item">Закрити</button>
    </div>

    <div id="transition-wrapper" class="full-screen-wrapper">
        <div class="center-text">
            @if (Model.StartActOrEnd)
            {
                <strong>Act: @Model.Act.Name</strong>
                <br /><br />
                @Model.Act.StartActText
            }
            else
            {
                <strong>End of Act: @Model.Act.Name</strong>
                <br /><br />
                @Model.Act.EndActText
            }
        </div>
    </div>

    <div class="scene-layer background" style="background-image: url('/scene_images/background_action_scene/black_background_action.jpg');"></div>
    <div class="scene-layer additional"></div>
    <div class="scene-layer front"></div>

    <script>
        // Pass the URL to the shared game.js file
        var actionUrl = '@Html.Raw(actionUrl)';
    </script>
    <script src="~/js/game.js" defer></script>
</body>
</html>