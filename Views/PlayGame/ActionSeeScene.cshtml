@model PlayGameSceneChange
@using NovelProject.AlterModels
@using NovelProject.Data
@inject AppDbContext _context

@{
    ViewData["Title"] = $"Scene {Model.CurrentScene.id}";
    Layout = null;
    var answers = Model.CurrentScene.answer ? _context.Answers.Where(a => a.id_scene == Model.CurrentScene.id).ToList() : new List<NovelProject.Models.AnswersModel>();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/game.css" />
</head>
<body>
    
    
@if (Model.Achivments != null && Model.Achivments.Any())
{
    <div id="achievement-popup">
        @foreach (var a in Model.Achivments)
        {
            <div class="achievement">
                <img src="@a.IconPath" alt="#" />
                <div class="achievement-text">
                    <strong>@a.Name</strong>
                    <span>@a.Description</span>
                </div>
            </div>
        }
    </div>
}



    <button id="game-menu-button" class="game-menu-button">
    <img id="menu-icon" src="/wwwroot/img/Purpule_Icon/НАЛАШТУВАННЯ.png" alt="Menu" />
    </button>
    <div id="gameMenuOverlay" class="game-menu-overlay hidden"></div>
    <div id="gameMenu" class="game-menu hidden">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button id="show-saves-btn" class="game-menu-item">Зберегти</button>
        }
        <button class="game-menu-item" onclick="alert('Settings not implemented yet')">Налаштування</button>
        <form method="get" asp-controller="PlayGame" asp-action="ManualSaveGame">
             <input type="hidden" name="partId" value="@Model.CurrentScene.id_part" />
             <input type="hidden" name="actId" value="@Model.actId" />
             <input type="hidden" name="sceneId" value="@Model.CurrentScene.id" />
             <input type="hidden" name="IsSaveFromScene" value="true" />
             <button class="game-menu-item" type="submit">Головне меню</button>
        </form>
        <button id="close-menu-btn" class="game-menu-item">Закрити</button>
    </div>
    <div id="saveSlots" class="save-slots hidden">
        <button class="save-slot" data-slot="1">Слот 1 @(!string.IsNullOrEmpty(Model.SaveFile.FirstSaveName) ? $" - {Model.SaveFile.FirstSaveName}" : "")</button>
        <button class="save-slot" data-slot="2">Слот 2 @(!string.IsNullOrEmpty(Model.SaveFile.SecondSaveName) ? $" - {Model.SaveFile.SecondSaveName}" : "")</button>
        <button class="save-slot" data-slot="3">Слот 3 @(!string.IsNullOrEmpty(Model.SaveFile.ThirdSaveName) ? $" - {Model.SaveFile.ThirdSaveName}" : "")</button>
        <button id="back-to-menu-btn" class="save-slot">Назад</button>
    </div>
    <div id="saveNameInput" class="save-name-input hidden">
        <form asp-controller="PlayGame" asp-action="SaveGame" method="post">
            <input type="hidden" name="selectedSlot" id="selectedSlot" />
            <input type="hidden" name="partId" value="@Model.CurrentScene.id_part" />
            <input type="hidden" name="actId" value="@Model.actId" />
            <input type="hidden" name="sceneId" value="@Model.CurrentScene.id" />
            <input type="text" name="saveName" placeholder="Введіть назву збереження" required />
            <button type="submit">Зберегти</button>
            <button type="button" id="cancel-save-btn">Скасувати</button>
        </form>
    </div>



<div class="scene-layer background" style="background-image: url('@Model.CurrentScene.background_scene_img'); width:100%; height:100%;"></div>
<div class="scene-layer additional" style="background-image: url('@Model.CurrentScene.additional_scene_img');"></div>
<div class="scene-layer front" style="background-image: url('@Model.CurrentScene.personage_scene_img');"></div>


<div class="ui-container">

    
        <div class="scene-text">
    @if (!Model.CurrentScene.answer)
    {
        
            <div id="text-background">
                <div class="text-content">
                    <strong>@Model.CurrentScene.text_scene</strong>
                </div>
            </div>
       
        @if (Model.EndOfPartReached)
        {
            <form method="get" asp-controller="PlayGame" asp-action="ActionSeePart">
                <input type="hidden" name="partId" value="@Model.CurrentScene.id_part" />
                <input type="hidden" name="actId" value="@Model.actId" />
                <input type="hidden" name="StartAct" value="false" />
                <input type="hidden" name="sceneId" value="@Model.NextSceneId" />
                <button type="submit" class="answer-button"></button>
            </form>
        }
        else
        {
            <form method="get" asp-controller="PlayGame" asp-action="ActionSeeScene">
                <input type="hidden" name="sceneId" value="@Model.NextSceneId" />
                <input type="hidden" name="actId" value="@Model.actId" />
                <input type="hidden" name="StartAct" value="@Model.StartPart" />
                <input type="hidden" name="partId" value="@Model.CurrentScene.id_part" />
                <button type="submit" class="answer-button"></button>
            </form>
        }
    }
</div>


@if (Model.CurrentScene.answer)
{
    <div class="answers">
        @foreach (var answer in answers)
        {
            <form method="get" asp-controller="PlayGame" asp-action="ActionSeeScene">
                <input type="hidden" name="sceneId" value="@answer.next_scene_id" />
                <input type="hidden" name="actId" value="@Model.actId" />
                <input type="hidden" name="StartAct" value="@Model.StartPart" />
                <input type="hidden" name="partId" value="@Model.CurrentScene.id_part" />
                <button type="submit" class="answers-button">@answer.asnwer_for_scene</button>
            </form>
        }
    </div>
}


<script>
    const achivmentIds = [
        @string.Join(", ", Model.Achivments.Select(a => a.Id))
    ];

    async function updateAchivmentsAsync() {
        if (achivmentIds.length === 0) return;

        try {
            await fetch('/PlayGame/UpdateAchivments', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(achivmentIds)
            });
        } catch (error) {
            console.error("Failed to update achivments:", error);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        updateAchivmentsAsync();

        const popup = document.getElementById("achievement-popup");
        if (popup) {
            popup.classList.add("show");   
            setTimeout(() => {
                popup.classList.remove("show"); 
            }, 5000);
        }
    });
</script>


    <script src="~/js/game.js" defer></script>
</body>
</html>