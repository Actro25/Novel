@model PlayGameSceneChange
@using NovelProject.AlterModels
@using NovelProject.Data
@inject AppDbContext _context

@{
    ViewData["Title"] = $"Scene {Model.CurrentScene.id}";

    Layout = null;
    
    // Подключаем необходимые скрипты
    <script src="~/js/site.js" defer></script>

    var answers = Model.CurrentScene.answer ? _context.Answers.Where(a => a.id_scene == Model.CurrentScene.id).ToList() : new List<NovelProject.Models.AnswersModel>();
}

<style>
    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
        font-family: Arial, sans-serif;
        background-color: black;
    }

    .scene-layer {
        position: absolute;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .background {
        z-index: 1;
        background-image: url('@Model.CurrentScene.background_scene_img');
    }

    .additional {
        z-index: 2;
        background-image: url('@Model.CurrentScene.additional_scene_img');
    }

    .front {
        z-index: 3;
        background-image: url('@Model.CurrentScene.personage_scene_img');
    }

    .scene-text, .answers {
        position: absolute;
        z-index: 4;
        bottom: 30px;
        width: 100%;
        text-align: center;
        color: white;
        text-shadow: 1px 1px 3px black;
        font-size: 1.5rem;
    }

    .answer-button {
        background-color: rgba(255,255,255,0.1);
        border: 2px solid white;
        color: white;
        padding: 0.5rem 1.5rem;
        margin: 0.5rem;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .answer-button:hover {
            background-color: rgba(255,255,255,0.3);
        }
</style>
<link rel="stylesheet" href="~/css/game-menu.css" />

<!-- Кнопка меню -->
<button class="game-menu-button" onclick="showGameMenu()">Меню</button>

<!-- Оверлей меню -->
<div id="gameMenuOverlay" class="game-menu-overlay"></div>

<!-- Основное меню -->
<div id="gameMenu" class="game-menu">
    @if (Context.User.Identity != null && Context.User.Identity.IsAuthenticated)
    {
        <button class="game-menu-item" onclick="showSaveSlots()">Зберегти</button>
    }
    <button class="game-menu-item" onclick="openSettings()">Налаштування</button>
    <button class="game-menu-item" onclick="goToMainMenu()">Головне меню</button>
    <button class="game-menu-item" onclick="hideGameMenu()">Закрити</button>
</div>

<!-- Слоты сохранения -->
<div id="saveSlots" class="save-slots">
    <button class="save-slot" onclick="showSaveNameInput(1)">
        Слот 1 @(!string.IsNullOrEmpty(Model.SaveFile.FirstSaveName) ? $" - {Model.SaveFile.FirstSaveName}" : "")
    </button>
    <button class="save-slot" onclick="showSaveNameInput(2)">
        Слот 2 @(!string.IsNullOrEmpty(Model.SaveFile.SecondSaveName) ? $" - {Model.SaveFile.SecondSaveName}" : "")
    </button>
    <button class="save-slot" onclick="showSaveNameInput(3)">
        Слот 3 @(!string.IsNullOrEmpty(Model.SaveFile.ThirdSaveName) ? $" - {Model.SaveFile.ThirdSaveName}" : "")
    </button>
    <button class="save-slot" onclick="hideGameMenu()">Назад</button>
</div>

<!-- Ввод имени сохранения -->
<div id="saveNameInput" class="save-name-input">
    <form asp-controller="PlayGame" asp-action="SaveGame" method="post">
        <input type="hidden" name="selectedSlot" id="selectedSlot" value="" />
        <input type="hidden" name="partId" value="@Model.CurrentScene.id_part" />
        <input type="hidden" name="actId" value="@Model.actId" />
        <input type="hidden" name="sceneId" value="@Model.CurrentScene.id" />
        <input type="text" name="saveName" id="saveName" placeholder="Введіть назву збереження" />
        <button type="submit" onclick="saveGame()">Зберегти</button>
    </form>
    <button onclick="hideGameMenu()">Скасувати</button>
</div>

<div class="scene-layer background"></div>
<div class="scene-layer additional"></div>
<div class="scene-layer front"></div>

<div class="scene-text">
    @if (!Model.CurrentScene.answer)
    {
        @if (Model.EndOfPartReached)
        {
            <form method="get" asp-controller="PlayGame" asp-action="ActionSeePart">
                <input type="hidden" name="partId" value="@Model.CurrentScene.id_part" />
                <input type="hidden" name="actId" value="@Model.actId" />
                <input type="hidden" name="StartAct" value="false" />
                <input type="hidden" name="sceneId" value="@Model.NextSceneId" />
                <button type="submit" class="answer-button">@Model.CurrentScene.text_scene</button>
            </form>
        }
        else
        {
            <form method="get" asp-controller="PlayGame" asp-action="ActionSeeScene">
                <input type="hidden" name="sceneId" value="@Model.NextSceneId" />
                <input type="hidden" name="actId" value="@Model.actId" />
                <input type="hidden" name="StartAct" value="@Model.StartPart" />
                <input type="hidden" name="partId" value="@Model.CurrentScene.id_part" />
                <button type="submit" class="answer-button">@Model.CurrentScene.text_scene</button>
            </form>
        }
    }

</div>

@if (Model.CurrentScene.answer)
{
    <div class="answers">
        @foreach (var answer in answers)
        {
            <form method="get" asp-controller="PlayGame" asp-action="ActionSeeScene">
                <input type="hidden" name="sceneId" value="@answer.next_scene_id" />
                <input type="hidden" name="actId" value="@Model.actId" />
                <input type="hidden" name="StartAct" value="@Model.StartPart" />
                <input type="hidden" name="partId" value="@Model.CurrentScene.id_part" />
                <button type="submit" class="answer-button">@answer.asnwer_for_scene</button>
            </form>
        }
    </div>
}
