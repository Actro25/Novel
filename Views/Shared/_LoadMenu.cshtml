<div id="loadMenu" class="menu-wrapper hidden">
    <h3 class="download-title">ЗАВАНТАЖИТИ ГРУ</h3>
    

    <div id="saveSlotsContainer" class="slot-list">
        @for (int i = 0; i < Model.SaveFiles.Count; i++)
        {
            var save = Model.SaveFiles[i];
            if (!string.IsNullOrEmpty(save.FileName))
            {
                <a href="@Url.Action("LoadGame", "PlayGame", new { sceneId = save.SceneId })" class="slot-item">
                    <input type="hidden" name="sceneId" value="@save.SceneId" />
                    <div class="slot-header">
                        <span class="slot-number">Слот @(i + 1)</span>
                    </div>
                    <div class="slot-name">@save.FileName</div>
                    <div class="slot-info">
                        <div>Акт: @save.ActName</div>
                        <div>Частина: @save.PartName</div>
                        <div class="slot-preview">@save.SceneFirstText</div>
                    </div>
                </a>
            }
            else
            {
                <div class="slot-item slot-disabled">
                    <div class="slot-header">
                        <span class="slot-number">Слот @(i + 1)</span>
                    </div>
                    <div class="slot-empty">Порожньо</div>
                </div>
            }
        }
    </div>

    <button id="closeLoadMenuBtn" class="menu-close-btn">ЗАКРИТИ</button>
</div>

<style>
#loadMenu {
    position: fixed;
    top: 50%;
    right: 150px;
    transform: translate(-50%, -50%);
    width: 536px;
    height: 793px;
    background: linear-gradient(180deg, rgba(21, 94, 141, 0.6) 0%, rgba(190, 166, 252, 0.6) 100%);
    border: 2px solid #BEA6FC;
    box-shadow: 0px 0px 90px 0px #FFFFFF, inset 0px 4px 4px 0px rgba(0, 0, 0, 0.25);
    border-radius: 16px;
    opacity: 1;
    z-index: 10;
    padding: 20px;
    
    backdrop-filter: blur(10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
}
.download-title{
    font-family: Franklin Gothic Heavy;
    font-weight: 400;
    font-style: Regular;
    font-size: 40px;
    leading-trim: NONE;
    line-height: 100%;
    letter-spacing: 12%;
    text-align: center;
    background: linear-gradient(99.74deg, #04C3E6 25.81%, #2F63E1 45.47%, #042AA6 54.98%, #7E4DF9 64.27%, #7E4DF9 70.91%),linear-gradient(105.67deg, #04C3E6 7.06%, #FFFFFF 54.91%, #7E4DF9 97.34%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 20px;

}

</style>




<script>
    document.addEventListener('DOMContentLoaded', function() {
        const loadMenu = document.getElementById('loadMenu');
        const closeLoadMenuBtn = document.getElementById('closeLoadMenuBtn');
        const saveSlotsContainer = document.getElementById('saveSlotsContainer');

        // Ця функція показує меню завантаження.
        // Її потрібно викликати з головного меню гри.
        function showLoadMenu() {
            renderLoadSlots(); // Оновлюємо слоти перед показом
            loadMenu.classList.remove('hidden');
            setTimeout(() => loadMenu.classList.add('active'), 10);
        }

        // Функція для закриття меню
        function hideLoadMenu() {
            loadMenu.classList.remove('active');
            setTimeout(() => loadMenu.classList.add('hidden'), 300);
        }

        // Прив'язуємо закриття до кнопки
        closeLoadMenuBtn.addEventListener('click', hideLoadMenu);


        // Обробка кліків на кнопках "Завантажити" та "Видалити"
        saveSlotsContainer.addEventListener('click', function(e) {
            const target = e.target;
            const slotId = target.dataset.slot;

            if (!slotId) return;

            if (target.classList.contains('load-btn')) {
                // Тут логіка завантаження гри
                window.location.href = '@Url.Action("LoadGame", "PlayGame")?slot=' + slotId;
            }

            if (target.classList.contains('delete-btn')) {
                if (confirm('Видалити це збереження?')) {
                    // Тут логіка видалення збереження
                    fetch('@Url.Action("DeleteSave", "Save")?slot=' + slotId, {
                        method: 'POST'
                    }).then(response => {
                        if (response.ok) {
                            location.reload(); // Оновити сторінку після видалення
                        }
                    });
                }
            }
        });
    });
</script>   