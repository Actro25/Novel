<div id="loadMenu" class="menu-wrapper hidden">
    <h3 class="download-title">ЗАВАНТАЖИТИ ГРУ</h3>
    

    <div id="saveSlotsContainer" class="slot-list">
        @for (int i = 0; i < Model.SaveFiles.Count; i++)
        {
            var save = Model.SaveFiles[i];
            if (!string.IsNullOrEmpty(save.FileName))
            {
                <div class="slot-item">
                    <div class="slot-header">
                        <span class="slot-title">СТОРІНКА&nbsp;<span class="slot-number">@save.SceneId</span></span>
                        <span class="slot-download">
                            <img src="/img/White_Icon/ЗАВАНТАЖИТИ.png" alt="download" width="22" height="22" />
                        </span>
                    </div>
                    <div class="slot-preview">@save.SceneFirstText</div>
                    <div class="slot-act">АКТ: @save.ActName</div>
                    <a href="@Url.Action("LoadGame", "PlayGame", new { sceneId = save.SceneId })" class="slot-continue-btn">ПРОДОВЖИТИ</a>
                    <div class="slot-part">ЧАСТИНА: @save.PartName</div>
                </div>
            }
            else
            {
                <div class="slot-item slot-disabled">
                    <div class="slot-header">
                        <span class="slot-title">Слот @(i + 1)</span>
                    </div>
                    <div class="slot-empty">Порожньо</div>
                </div>
            }
        }
    </div>

    <button id="closeLoadMenuBtn" class="menu-close-btn">ЗАКРИТИ</button>
</div>

<style>
    #loadMenu {
        position: fixed;
        top: 50%;
        right: 150px;
        transform: translate(-50%, -50%);
        width: 536px;
        height: 793px;
        background: linear-gradient(180deg, rgba(21, 94, 141, 0.6) 0%, rgba(190, 166, 252, 0.6) 100%);
        border: 2px solid #BEA6FC;
        box-shadow: 0px 0px 90px 0px #FFFFFF, inset 0px 4px 4px 0px rgba(0, 0, 0, 0.25);
        border-radius: 16px;
        opacity: 1;
        z-index: 10;
        padding: 20px;
        
        backdrop-filter: blur(10px);
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .download-title {
        font-family: 'Franklin Gothic Heavy', Arial, sans-serif;
        font-weight: 700;
        font-size: 40px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        line-height: 1;
        text-align: center;
        background: linear-gradient(105.67deg, #04C3E6 7.06%, #FFFFFF 54.91%, #7E4DF9 97.34%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
        margin: 0 auto;
        width: 100%;
        padding: 0;
        border-radius: 0;
        box-shadow: none;
        opacity: 1;
        position: static;
    }
    .slot-list {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 24px;
        align-items: center;
    }
    .slot-item {
        width: 465px;
        min-height: 174px;
        border-radius: 25px;
        border: 2px solid #BEA6FC;
        background: linear-gradient(180deg, rgba(21, 94, 141, 0.6) 0%, rgba(190, 166, 252, 0.6) 100%);
        opacity: 1;
        position: relative;
        backdrop-filter: blur(12.5px);
        display: flex;
        flex-direction: column;
        justify-content: space-between; /* distribute space, part at bottom */
        box-sizing: border-box;
        padding: 20px 22px 20px 22px;
        overflow: hidden;
    }
    .slot-header {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
        font-family: 'Franklin Gothic Medium', Arial, sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 6px;
    }
    .slot-title {
        font-family: 'Aldrich', Arial, sans-serif;
        font-weight: 400;
        font-style: normal;
        font-size: 24px;
        line-height: 1;
        letter-spacing: 0;
    }
    .slot-number {
        font-weight: 700;
        font-size: 22px;
        color: #fff;
    }
    .slot-download {
        margin-left: 8px;
        display: flex;
        align-items: center;
    }
    .slot-preview {
        font-family: 'Franklin Gothic Medium', Arial, sans-serif;
        font-size: 16px;
        color: #fff;
        margin-bottom: 4px;
        margin-top: 2px;
        font-weight: 500;
    }
    .slot-act {
        font-family: 'Aldrich', Arial, sans-serif;
        font-weight: 400;
        font-style: normal;
        font-size: 14px;
        line-height: 1;
        letter-spacing: 0;
        color: #1E469D;
        padding: 2px 8px;
        border-radius: 6px;
        display: inline-block;
        margin-bottom: 2px;
        opacity: 1;
        align-self: flex-start;
        text-align: left;
    }
    .slot-part {
        font-family: 'Aldrich', Arial, sans-serif;
        font-weight: 400;
        font-style: normal;
        font-size: 13px;
        line-height: 1;
        letter-spacing: 0;
        color: #1E469D;
        padding: 2px 8px;
        border-radius: 6px;
        display: inline-block;
        margin-top: 0;
        margin-bottom: 0;
        opacity: 1;
        align-self: flex-start;
        text-align: left;
    }
    .slot-continue-btn {
        width: 201px;
        height: 40px;
        border-radius: 8px;
        border: 1px solid #BEA6FC;
        background: #7E4DF9;
        color: #fff;
        font-family: 'Franklin Gothic Medium', Arial, sans-serif;
        font-size: 18px;
        font-weight: 700;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 10px;
        margin-top: 12px;
        margin-bottom: 0;
        align-self: flex-end;
        top: unset;
        box-shadow: none;
        transition: background 0.2s, border-color 0.2s;
        cursor: pointer;
    }
    .slot-continue-btn:hover {
        background: #5a2fc7;
        border-color: #7E4DF9;
        box-shadow: 0 0 16px 0 #04C3E6;
        color: #fff;
    }
    .slot-disabled {
        width: 465px;
        height: 174px;
        border-radius: 25px;
        border: 2px solid #BEA6FC;
        background: linear-gradient(180deg, rgba(21, 94, 141, 0.3) 0%, rgba(190, 166, 252, 0.3) 100%);
        opacity: 0.7;
        position: relative;
        backdrop-filter: blur(12.5px);
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        overflow: hidden;
    }
    .slot-empty {
        font-family: 'Franklin Gothic Medium', Arial, sans-serif;
        font-size: 22px;
        color: #fff;
        opacity: 0.5;
    }
    .menu-close-btn {
        width: 321px;
        height: 46px;
        border-radius: 8px;
        border: 1px solid #BEA6FC;
        background: #7E4DF9;
        color: #fff;
        font-family: 'Franklin Gothic Medium', Arial, sans-serif;
        font-size: 22px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 10px;
        margin: 32px auto 0 auto;
        box-shadow: none;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s;
    }
    .menu-close-btn:hover {
        background: #5a2fc7;
        border-color: #7E4DF9;
    }
</style>




<script>
    document.addEventListener('DOMContentLoaded', function() {
        const loadMenu = document.getElementById('loadMenu');
        const closeLoadMenuBtn = document.getElementById('closeLoadMenuBtn');
        const saveSlotsContainer = document.getElementById('saveSlotsContainer');

        // Ця функція показує меню завантаження.
        // Її потрібно викликати з головного меню гри.
        function showLoadMenu() {
            renderLoadSlots(); // Оновлюємо слоти перед показом
            loadMenu.classList.remove('hidden');
            setTimeout(() => loadMenu.classList.add('active'), 10);
        }

        // Функція для закриття меню
        function hideLoadMenu() {
            loadMenu.classList.remove('active');
            setTimeout(() => loadMenu.classList.add('hidden'), 300);
        }

        // Прив'язуємо закриття до кнопки
        closeLoadMenuBtn.addEventListener('click', hideLoadMenu);


        // Обробка кліків на кнопках "Завантажити" та "Видалити"
        saveSlotsContainer.addEventListener('click', function(e) {
            const target = e.target;
            const slotId = target.dataset.slot;

            if (!slotId) return;

            if (target.classList.contains('load-btn')) {
                // Тут логіка завантаження гри
                window.location.href = '@Url.Action("LoadGame", "PlayGame")?slot=' + slotId;
            }

            if (target.classList.contains('delete-btn')) {
                if (confirm('Видалити це збереження?')) {
                    // Тут логіка видалення збереження
                    fetch('@Url.Action("DeleteSave", "Save")?slot=' + slotId, {
                        method: 'POST'
                    }).then(response => {
                        if (response.ok) {
                            location.reload(); // Оновити сторінку після видалення
                        }
                    });
                }
            }
        });
    });
</script>