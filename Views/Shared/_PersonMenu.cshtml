<div id="personMenu" class="character-menu">
    <div class="menu-bar">
        <span class="label">ПЕРСОНАЖІ</span>
    </div>
    <div class="cards custom-layout">
        <button class="card mia" onclick="openOverlay('Мія у реальному світі', '/img/Mia.png', '', 'mia')">
            <div class="art"><img src="/img/Мія.png" alt="Мія"></div>
            <p class="name">Мія</p>
        </button>

        <button class="card kit" onclick="openOverlay(kitData.name, kitData.src, kitData.desc, kitData.cls)">
            <div class="art"><img src="/img/Кіт.png" alt="Неоновий кіт"></div>
            <p class="name">Неоновий кіт</p>
        </button>

        <button class="card obriy" onclick="openOverlay(obriyData.name, obriyData.src, obriyData.desc, obriyData.cls)">
            <div class="art"><img src="/img/Обрій.png" alt="Обрій"></div>
            <p class="name">Обрій</p>
        </button>

        <button class="card vodiy" onclick="openOverlay(vodiyData.name, vodiyData.src, vodiyData.desc, vodiyData.cls)">
            <div class="art"><img src="/img/Водій.png" alt="Водій"></div>
            <p class="name">Водій</p>
        </button>

        <button class="card pryvid" onclick="openOverlay(pryvidData.name, pryvidData.src, pryvidData.desc, pryvidData.cls)">
            <div class="art"><img src="/img/Привід.png" alt="Привид"></div>
            <p class="name">Привид</p>
        </button>
    </div>
</div>

<div id="overlay-backdrop"></div>

<div id="overlay">
    <div class="overlay-content">
        <div class="overlay-img-wrapper">
            <img id="overlay-img" src="" alt="Персонаж">
            <div id="overlay-extra-imgs"></div>
        </div>

        <div class="overlay-text-wrapper">
            <h2 id="overlay-name">Имя персонажа</h2>
            <p id="overlay-description">Описание персонажа появится здесь.</p>

            <div class="mia-switch-wrapper">
                <img class="mia-switch-img" src='/img/Purpule_Icon/ПРОДОВЖИТИ2.png' alt="">
            </div>
        </div>
    </div>
    <button class="close-btn" onclick="closeOverlay()">Закрити</button>
</div>

<script>
