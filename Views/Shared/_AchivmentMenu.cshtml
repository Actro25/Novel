<div id="achivmentsMenu" class="load-menu-container hidden">
    <h3 class="load-title">ДОСЯГНЕННЯ</h3>

    <div id="achivmentContainer" class="save-slots">
        @{
            var achievedIds = new HashSet<int>();
            if (Context.User.Identity != null && Context.User.Identity.IsAuthenticated)
            {
                var userAchivmentsList = Model.UserAchivments as List<UserAchivmentsModel>;
                if (userAchivmentsList != null)
                {
                    achievedIds = userAchivmentsList
                        .Where((Func<UserAchivmentsModel, bool>)(a => a.IsAchieved))
                        .Select(a => a.AchivmentId)
                        .ToHashSet();
                }
            }
        }

        @foreach (var ach in Model.AllAhivments)
        {
            var isAchieved = achievedIds.Contains(ach.Id);
            <div class="save-slot @(isAchieved ? "achieved" : "locked")">
                <div class="save-slot-header">
                    <span class="save-slot-number">@ach.Name</span>
                </div>
                <div class="save-slot-info">
                    <div class="achievement-icon-container">
                        <img src="@(isAchieved ? ach.IconPath : "/img/question.jpg")" 
                             alt="@ach.Name" 
                             class="achievement-icon @(isAchieved ? "" : "grayscale")" />
                    </div>
                    <div class="scene-preview">@ach.Description</div>
                </div>
            </div>
        }
    </div>

    <button id="closeAchivmentsMenuBtn" class="close-button">ЗАКРИТИ</button>
</div>



<style>
     .save-slot {
        position: relative;
        border: 2px solid;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 15px;
        transition: all 0.3s ease;
    }

    .save-slot.achieved {
        border-color: #00ff8c;
        background-color: rgba(0, 255, 140, 0.1);
        box-shadow: 0 0 15px rgba(0, 255, 140, 0.3);
    }

    .save-slot.locked {
        border-color: #555;
        opacity: 0.6;
        background-color: rgba(85, 85, 85, 0.1);
    }
    .achievement-icon-container {
        width: 80px;
        height: 80px;
        margin-right: 15px;
        float: left;
        border-radius: 8px;
        overflow: hidden;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .achievement-icon {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: all 0.3s ease;
    }
    .achieved .achievement-icon {
        border: 1px solid #00ff8c;
        box-shadow: 0 0 10px rgba(0, 255, 140, 0.5);
    }
    .grayscale {
        filter: grayscale(100%) brightness(0.7);
    }
    .achievements-menu-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: rgba(10, 20, 35, 0.95);
        border: 2px solid #ffb400;
        border-radius: 15px;
        box-shadow: 0 0 30px rgba(255, 180, 0, 0.5);
        padding: 25px;
        color: white;
        z-index: 1000;
        width: 90%;
        max-width: 600px;
        opacity: 0;
        transition: opacity 0.3s ease, transform 0.3s ease;
        transform: translate(-50%, -50%) scale(0.95);
    }

    .achievements-menu-container.active {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }

    .achievements-menu-container.hidden {
        display: none;
    }

    .achievements-title {
        text-align: center;
        margin-bottom: 20px;
        font-size: 1.8em;
        color: #ffb400;
        text-shadow: 0 0 10px #ffb400;
    }

    .achievements-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
        max-height: 400px;
        overflow-y: auto;
    }

    .achievement-card {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        padding: 15px;
        transition: background-color 0.3s ease;
    }

    .achievement-card.achieved {
        border-color: #00ff8c;
    }

    .achievement-name {
        font-size: 1.2em;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .achievement-desc {
        font-size: 0.95em;
        color: #aaa;
        margin-bottom: 10px;
    }

    .achievement-status {
        font-size: 0.9em;
        color: #ffcc00;
    }
    .save-slot-info::after {
        content: "";
        display: table;
        clear: both;
    }
</style>

<script>
    document.getElementById('closeAchivmentsMenuBtn').addEventListener('click', () => {
        const menu = document.getElementById('achivmentsMenu');
        menu.classList.remove('active');
        setTimeout(() => menu.classList.add('hidden'), 300);
    });

</script>

