@using NovelProject.AlterModels
@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="stars-bg">
        <!-- You can insert SVG or canvas for stars here -->
    </div>
    <div class="auth-center-wrap">
        <div class="auth-container">
            <form method="post" asp-action="RegisterUser">
                <div class="inputBox" style="display: flex; justify-content: center;">
                    <img class="logo" src="/img/Frame1.png" alt="cat logo" />
                </div>
                <div class="inputBox">
                    <input type="text" asp-for="Name" name="Name" value="@Model.Name" placeholder="Name" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="inputBox">
                    <input type="text" asp-for="Email" name="Email" value="@Model.Email" placeholder="Email" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="inputBox">
                    <input type="password" asp-for="Password" name="Password" value="@Model.Password" placeholder="Password" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="inputBox">
                    <input type="password" asp-for="ConfirmPassword" name="ConfirmPassword" value="@Model.ConfirmPassword" placeholder="Confirm password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="login-btn">Register</button>
                <div class="register-link">
                    <span>Already have an account?</span>
                    <a href="@Url.Action("LoginUser", "Login")">Log in</a>
                </div>
            </form>
        </div>
    </div>
    <script src="~/js/stars.js"></script>
    <script src="~/js/login.js"></script>
</body>
</html>
