@using NovelProject.AlterModels
@model LoginViewModel
@{
    ViewData["Title"] = "Login or Register";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="stars-bg">
        <!-- You can insert SVG or canvas for stars here -->
    </div>
    <div class="auth-center-wrap">
        <div class="auth-container">
            <img src="/img/Frame1.png" alt="cat logo" class="logo" />
            <form method="post" asp-action="LoginUser">
                <div class="inputBox">
                    <input type="text" asp-for="Email" name="Email" value="@Model.Email" placeholder="Email" required />
                    <span asp-validation-for="Email" class="text-danger"></span>

                    <input type="password" asp-for="Password" name="Password" value="@Model.Password" placeholder="Password" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="links">
                    <a href="@Url.Action("Login", "Login")">Sign in with Google</a>
                    <a href="#">Forgot password?</a>
                </div>
                <button type="submit" class="login-btn">Log in</button>
                <div class="register-link">
                    <span>Don't have an account?</span>
                    <a href="@Url.Action("RegisterUser", "Login")">Register</a>
                </div>
            </form>
        </div>
    </div>
    <script src="~/js/stars.js"></script>
    <script src="~/js/login.js"></script>
    <script>
    // Fix for parallax stars on login page: ensure script runs after stars are created
    window.addEventListener('DOMContentLoaded', function () {
      setTimeout(function() {
        if (typeof animateStars === 'function') animateStars();
      }, 100);
    });
    </script>
</body>
</html>