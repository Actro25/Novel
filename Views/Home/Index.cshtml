@using NovelProject.AlterModels
@model List<ShowSaveFileModel>
<!DOCTYPE html>
<html lang="uk">
﻿@{
ViewData["Title"] = "Dream Inspired Menu";
Layout = null;
}

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@ViewData["Title"]</title>
<link rel="stylesheet" href="~/css/site.css">

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji">
</head>
<body>
@if (Context.User.Identity != null && Context.User.Identity.IsAuthenticated)
{
    <div class="top-right-buttons" style="position: absolute; top: 15px; right: 20px; z-index: 100;">
        <label class="text-white">
            @Context.User.Identity.Name
        </label>
        <a href="@Url.Action("LogOut", "Login")">Вихід</a>
    </div>
}
else
{
    <div aria-label="User Login Button"
            tabindex="0"
            role="button"
            class="user-profile"
            style="position: absolute; top: 28px; right: 48px; z-index: 100;"
            onclick="window.location.href='@Url.Action("LoginUser", "Login")'"
            onkeydown="if(event.key==='Enter'){window.location.href='@Url.Action("LoginUser", "Login")'}">
        <div class="user-profile-inner">
            <svg aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24">
                <g data-name="Layer 2" id="Layer_2">
                    <path d="m15.626 11.769a6 6 0 1 0 -7.252 0 9.008 9.008 0 0 0 -5.374 8.231 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 9.008 9.008 0 0 0 -5.374-8.231zm-7.626-4.769a4 4 0 1 1 4 4 4 4 0 0 1 -4-4zm10 14h-12a1 1 0 0 1 -1-1 7 7 0 0 1 14 0 1 1 0 0 1 -1 1z"></path>
                </g>
            </svg>
            <p>Log In</p>
        </div>
    </div>
}
<div class="main-flex-wrap" style="display: flex; align-items: flex-start; gap: 32px;">
    <div class="menu-container" id="mainMenuContainer">
        <h1 class="menu-title center-title"><span>DREAM</span><span class="alt">.EXE</span></h1>
        <div class="main-menu-label">ГОЛОВНЕ МЕНЮ</div>
        <ul class="main-menu">
            <li><a href="@Url.Action("Index", "PlayGame")" class="menu-item" data-lang-key="peaceful_mode"><span>ГРАТИ</span><svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></a></li>
            <li><a href="#" class="menu-item" id="continueGameLink" data-lang-key="continue_game"><span>ПРОДОВЖИТИ</span><svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v16a4 4 0 0 0 8 0v-4"/></svg></a></li>
            <li><a href="@Url.Action("Index", "PlayGame")" class="menu-item" data-lang-key="new_game"><span>НОВА ГРА</span><svg class="menu-icon new-game-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2" ry="2"/><path d="M16 3v4M8 3v4"/></svg></a></li>
            <li><a href="#" class="menu-item" id="loadGameLink" data-lang-key="load_game"><span>ЗАВАНТАЖИТИ</span><svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></a></li>
            <li><a href="#" class="menu-item" data-lang-key="characters"><span>ПЕРСОНАЖІ</span><svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/></svg></a></li>
            <li><a href="#" class="menu-item" data-lang-key="settings" id="settingsLink"><span>НАЛАШТУВАННЯ</span><svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V19a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H5a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H11a1.65 1.65 0 0 0 1-1.51V5a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51z"/></svg></a></li>
            <li><a href="#" class="menu-item" data-lang-key="achievements"><span>ДОСЯГНЕННЯ</span> <span class="achievement-count">26/26</span><svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></a></li>
            <li><a href="#" class="menu-item" id="authorsLink" data-lang-key="authors"><span>АВТОРИ</span></a></li>
            <li style="display: flex; gap: 1.2em; justify-content: flex-start; background: none; box-shadow: none; border: none;">
                <div class="lang-voice-block">
                    <div class="lang-voice-title">Мова</div>
                    <div class="lang-voice-value">Українська</div>
                </div>
                <div class="lang-voice-block">
                    <div class="lang-voice-title">Озвучка</div>
                    <div class="lang-voice-value">Українська</div>
                </div>
            </li>
            <li>
                <a href="#" id="exitLabel" class="exit-label" tabindex="0" role="button" data-lang-key="exit">ВИХІД</a>
            </li>
        </ul>

    </div>
    <div id="authorsMenu" class="authors-menu-container hidden">
        <h3 class="authors-title" data-lang-key="authors_novel_title">АВТОРИ НОВЕЛИ</h3>
        <ul class="authors-list">
            <li><p data-lang-key="scenario_writer" class="author-info">Сценарист: <span class="author-name">Alyona Okey</span></p></li>
            <li><p data-lang-key="artist" class="author-info">Художник: <span class="author-name">Alyona Okey, Zorochka 🍃, Youbi</span></p></li>
            <li><p data-lang-key="programmer" class="author-info">Програміст: <span class="author-name">_ТоРтІк_, 𝕯𝖎𝖘𝖆𝖏</span></p></li>
            <li><p data-lang-key="music" class="author-info">Музика: <span class="author-name">𝕯𝖎𝖘𝖆𝖏</span></p></li>
        </ul>
        <button id="closeAuthorsMenu" class="close-button" data-lang-key="close">ЗАКРИТИ</button>
    </div>
    <div id="settingsMenu" class="settings-menu-container hidden">
        <h3 class="settings-title" data-lang-key="settings_title">НАЛАШТУВАННЯ</h3>
        <div class="settings-section">
            <h4 data-lang-key="interface_themes">ТЕМИ ІНТЕРФЕЙСУ</h4>
            <div class="theme-options">
                <button class="theme-button" id="themeLight" data-lang-key="theme_light">СВІТЛА</button>
                <button class="theme-button" id="themeDark" data-lang-key="theme_dark">ТЕМНА</button>
            </div>
        </div>
        <div class="settings-section">
            <h4 data-lang-key="interface_scale">МАСШТАБ ІНТЕРФЕЙСУ</h4>
            <div class="scale-options">
                <button class="scale-button" id="scaleSmall" data-scale="small">ДРІБНИЙ</button>
                <button class="scale-button" id="scaleNormal" data-scale="normal">ЗВИЧАЙНИЙ</button>
                <button class="scale-button" id="scaleLarge" data-scale="large">ВЕЛИКИЙ</button>
            </div>
        </div>
        <div class="settings-section">
            <h4 data-lang-key="language">МОВА</h4>
            <div class="language-settings-options">
                <button class="lang-button" data-lang="uk">Українська</button>
                <button class="lang-button" data-lang="ru">Російська</button>
                <button class="lang-button" data-lang="en">Англійська</button>
            </div>
        </div>
        <div class="settings-section">
            <h4 data-lang-key="music">МУЗИКА</h4>
            <div class="music-controls">
                <button class="music-toggle" id="musicOnBtn" style="display:none;">Включити</button>
                <button class="music-toggle" id="musicOffBtn" style="display:none;">Вимкнути</button>
                <input type="range" min="0" max="100" value="0" class="music-slider" id="musicSlider">
                <span class="music-volume-value" id="musicVolumeValue">0</span>
                <span class="music-volume-max">/100</span>
            </div>
            <div class="music-title-row">
            <button class="music-arrow-btn" id="musicPrev">
                <svg class="music-arrow-svg" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="music-title-block music-title-block-flat">
                <span id="musicTitle">МЕЛОДІЯ 1</span>
            </div>
            <button class="music-arrow-btn" id="musicNext">
                <svg class="music-arrow-svg" viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            </div>
        </div>
        <button id="closeSettingsMenu" class="close-button" data-lang-key="close">ЗАКРИТИ</button>
    </div>
</div>
@await Html.PartialAsync("_LoadMenu")
<script src="~/js/site.js"></script>
<script>
    document.getElementById('loadGameLink').addEventListener('click', function(e) {
        e.preventDefault();
        const loadMenu = document.getElementById('loadMenu');
        const settingsMenu = document.getElementById('settingsMenu');
        const authorsMenu = document.getElementById('authorsMenu');

        // Hide other menus
        if (settingsMenu && !settingsMenu.classList.contains('hidden')) {
            settingsMenu.classList.add('hidden');
        }
        if (authorsMenu && !authorsMenu.classList.contains('hidden')) {
            authorsMenu.classList.add('hidden');
        }

        // Toggle load menu with animation classes
        if (loadMenu.classList.contains('hidden')) {
            loadMenu.classList.remove('hidden');
            setTimeout(() => loadMenu.classList.add('active'), 10);
        } else {
            loadMenu.classList.remove('active');
            setTimeout(() => loadMenu.classList.add('hidden'), 300);
        }
    });

    // Обработчик для кнопки "ПРОДОВЖИТИ" - загрузка последнего сохранения
    document.getElementById('continueGameLink').addEventListener('click', function(e) {
        e.preventDefault();
        // Здесь должна быть логика загрузки последнего сохранения
        // Пока что просто перенаправляем к игре
        console.log('Загрузка последнего сохранения...');
        window.location.href = '@Url.Action("Index", "PlayGame")';
    });
</script>

<audio id="bgMusic" preload="auto"></audio>
</body>
</html>
