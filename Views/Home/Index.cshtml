@{
    ViewData["Title"] = "Dream Inspired Menu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <div class="menu-container" id="mainMenuContainer">
        <h1 class="menu-title center-title"><span>DREAM</span><span class="alt">.EXE</span></h1>
        <ul class="main-menu">
            <li><a href="#" class="menu-item" data-lang-key="peaceful_mode"><span>МИРНИЙ РЕЖИМ</span> <span class="icon">🌙</span></a></li>
            <li><a href="#" class="menu-item" data-lang-key="continue_game"><span>ПРОДОВЖИТИ</span> <span class="icon">🐾</span></a></li>
            <li><a href="#" class="menu-item" data-lang-key="new_game"><span>НОВА ГРА</span> <span class="icon">🆕</span></a></li>
            <li><a href="#" class="menu-item" id="loadGameLink" data-lang-key="load_game"><span>ЗАВАНТАЖИТИ</span> <span class="icon">💾</span></a></li>
            <li><a href="#" class="menu-item" data-lang-key="characters"><span>ПЕРСОНАЖІ</span> <span class="icon">👤</span></a></li>
            <li><a href="#" class="menu-item" data-lang-key="clothes"><span>ОДЯГ</span> <span class="icon">👗</span></a></li>
            <li><a href="#" class="menu-item" id="settingsLink" data-lang-key="settings"><span>НАЛАШТУВАННЯ</span> <span class="icon">⚙️</span></a></li>
            <li><a href="#" class="menu-item" data-lang-key="achievements"><span>ДОСЯГНЕННЯ</span> <span class="icon">🛡️</span> <span class="achievement-count">26/26</span></a></li>
            <li><a href="#" class="menu-item" id="authorsLink" data-lang-key="authors"><span>АВТОРИ</span> <span class="icon">👥</span></a></li>
            <li class="language-row highlight-language-row">
                <span class="menu-item language-label" data-lang-key="language">
                    <span class="lang-icon" aria-hidden="true">🌐</span> Мова
                </span>
                <span class="language-value highlight-language-value" id="languageValue">Українська</span>
            </li>
            <li class="language-row highlight-language-row">
                <span class="menu-item language-label" data-lang-key="voiceover">
                    <span class="lang-icon" aria-hidden="true">🔊</span> Озвучка
                </span>
                <span class="language-value highlight-language-value" id="voiceoverValue">Українська</span>
            </li>
            <li>
                <a href="#" id="exitLabel" class="exit-label" tabindex="0" role="button" data-lang-key="exit">ВИХІД</a>
            </li>
        </ul>
    </div>

    <div id="authorsMenu" class="authors-menu-container hidden">
        <h3 class="authors-title" data-lang-key="authors_novel_title">АВТОРИ НОВЕЛИ</h3>
        <ul class="authors-list">
            <li><p data-lang-key="scenario_writer" class="author-info">Сценарист: <span class="author-name">Alyona Okey</span></p></li>
            <li><p data-lang-key="artist" class="author-info">Художник: <span class="author-name">Alyona Okey, Zorochka 🍃, Youbi</span></p></li>
            <li><p data-lang-key="programmer" class="author-info">Програміст: <span class="author-name">_ТоРтІк_, 𝕯𝖎𝖘𝖆𝖏</span></p></li>
            <li><p data-lang-key="music" class="author-info">Музика: <span class="author-name">𝕯𝖎𝖘𝖆𝖏</span></p></li>
        </ul>
        <button id="closeAuthorsMenu" class="close-button" data-lang-key="close">ЗАКРИТИ</button>
    </div>

    <div id="settingsMenu" class="settings-menu-container hidden">
        <h3 class="settings-title" data-lang-key="settings_title">НАЛАШТУВАННЯ</h3>
        <div class="settings-section">
            <h4 data-lang-key="interface_themes">ТЕМИ ІНТЕРФЕЙСУ</h4>
            <div class="theme-options">
                <button class="theme-button" id="themeLight" data-lang-key="theme_light">СВІТЛА</button>
                <button class="theme-button" id="themeDark" data-lang-key="theme_dark">ТЕМНА</button>
            </div>
        </div>
        <div class="settings-section">
            <h4 data-lang-key="interface_scale">МАСШТАБ ІНТЕРФЕЙСУ</h4>
            <div class="scale-options">
                <button class="scale-button" id="scaleSmall" data-scale="small">ДРІБНИЙ</button>
                <button class="scale-button" id="scaleNormal" data-scale="normal">ЗВИЧАЙНИЙ</button>
                <button class="scale-button" id="scaleLarge" data-scale="large">ВЕЛИКИЙ</button>
            </div>
        </div>
        <div class="settings-section">
            <h4 data-lang-key="language">МОВА</h4>
            <div class="language-settings-options">
                <button class="lang-button" data-lang="uk">Українська</button>
                <button class="lang-button" data-lang="ru">Російська</button>
                <button class="lang-button" data-lang="en">Англійська</button>
            </div>
        </div>
        <div class="settings-section">
            <h4 data-lang-key="music">МУЗИКА</h4>
            <div class="music-controls">
                <button class="music-toggle" id="musicOnBtn" style="display:none;">Включити</button>
                <button class="music-toggle" id="musicOffBtn" style="display:none;">Вимкнути</button>
                <input type="range" min="0" max="100" value="0" class="music-slider" id="musicSlider">
                <span class="music-volume-value" id="musicVolumeValue">0</span>
                <span class="music-volume-max">/100</span>
            </div>
            <div class="music-player">
                <button class="music-title-btn" id="musicPrev">&lt;</button>
                <span id="musicTitle">МЕЛОДІЯ 1</span>
                <button class="music-title-btn" id="musicNext">&gt;</button>
            </div>
        </div>
        <button id="closeSettingsMenu" class="close-button" data-lang-key="close">ЗАКРИТИ</button>
    </div>

    <script src="~/js/site.js"></script>
    <audio id="bgMusic" preload="auto"></audio>
</body>
</html>
</html>
