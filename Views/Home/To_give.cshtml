<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" asp-append-version="true" href="~/css/game.css" />
    <script src="~/js/game.js"></script>
    <title>Choice</title>
    

        <div class="scene-text">
    <form asp-action="ConnectFromAnimationToScene" asp-controller="PlayGame" method="get">
        <div id="text-background">
            <div class="text-content">
                <span>Місто "падає" вниз, і вона опиняється в…</span>
                <input type="hidden" name="partId" value="1" />
                <input type="hidden" name="actId" value="1" />
                <input type="hidden" name="StartAct" value="false" />
                <input type="hidden" name="sceneId" value="31" />

                <button type="submit" class="answer-button"></button>
            </div>
        </div>
    </form>


        


<style>
.background-video {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%; /* Полная высота экрана */
    overflow: hidden;
    z-index: -1; /* Чтобы было за контентом */
}

.background-video video {
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    object-fit: cover; /* Растягивание без искажений */

#text-background {
    position: fixed;
    top: 772px;
    left: 393px;
    width: 1135px;
    height: 137px;
    border-radius: 25px;
    border: 2px solid #BEA6FC;
    padding: 20px 25px;
    background: linear-gradient(
        180deg,
        rgba(206, 63, 201, 0.5) 0%,
        rgba(2, 10, 32, 0.5) 16.83%,
        rgba(126, 77, 249, 0.5) 100%
    );
    color: white;
    font-size: 1.5rem;
    text-shadow: 1px 1px 3px black;
    display: flex;
    align-items: center;
    justify-content: center; /* выравнивание содержимого */
    box-sizing: border-box;
}


#text-background .text-content {
    font-family: Arial, Roboto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between; /* текст в центре, кнопка справа */
    font-size: calc(1.2rem + 0.8vw);
}



</style>

</head>
<body>
    <div class="background-video">
    <video autoplay muted loop playsinline>
        <source src="/img/To_give.mp4" type="video/mp4">
    </video>
</div>


    <button id="game-menu-button" class="game-menu-button">
        <img id="menu-icon" src="@Url.Content("~/img/Purpule_Icon/НАЛАШТУВАННЯ.png")" alt="Menu" />
    </button>
    <div id="gameMenuOverlay" class="game-menu-overlay hidden"></div>
    <div id="gameMenu" class="game-menu hidden">
    
    
    
        <button class="game-menu-item" onclick="alert('Settings not implemented yet')">Налаштування</button>
        <button id="close-menu-btn" class="game-menu-item">Закрити</button>
    </div>
    

    
</body>
</html>